    {
      "id": "patch_1",
      "titulo": "PATCH 1/3",
      "enunciado": "O escudo (e) do Kernel Panic tem 100 de energia. Tire 25 de cada vez enquanto ele for maior que zero: cada redução lança um tiro (4 no total). No fim, mostre DESLIGOU.",
      "entrada": "Nenhuma.",
      "saida": [
        "Mostre DESLIGOU."
      ],
      "exemplos": [
        {
          "entrada": "-",
          "saida": "DESLIGOU"
        }
      ],
      "trechos": [
        {
          "id": "a1",
          "codigo": "e = 100",
          "tipo": "entrada"
        },
        {
          "id": "a2",
          "codigo": "while e > 0:",
          "tipo": "decisao"
        },
        {
          "id": "a3",
          "codigo": "e = e - 25",
          "tipo": "outro"
        },
        {
          "id": "a4",
          "codigo": "print(\"DESLIGOU\")",
          "tipo": "saida"
        }
      ],
      "solucao": [
        {
          "id": "a1",
          "indent": 0
        },
        {
          "id": "a2",
          "indent": 0
        },
        {
          "id": "a3",
          "indent": 1
        },
        {
          "id": "a4",
          "indent": 0
        }
      ],
      "testes": [
        {
          "entrada": "",
          "esperado": "DESLIGOU"
        }
      ],
      "dica": "O while repete enquanto a condição for verdadeira. Diminua o escudo dentro do laço (recuado) e mostre a mensagem depois, fora dele.",
      "disparos": 4,
      "simulacao": {
        "codigo": "while e > 0:",
        "variavel": "e",
        "inicio": "100",
        "passos": ["75", "50", "25", "0"],
        "linha": "e = e - 25",
        "fim": "e > 0 é falso: DESLIGOU"
      },
      "aprendizado": "o while tirou 25 do escudo até chegar a 0"
    },
    {
      "id": "patch_2",
      "titulo": "PATCH 2/3",
      "enunciado": "Para bloquear o laser, o sistema pede uma senha (s). Se a senha for byte, mostre LIBERADO para autorizar um tiro. Senão, mostre NEGADO.",
      "entrada": "Uma palavra (a senha).",
      "saida": [
        "Se for byte: LIBERADO.",
        "Senão: NEGADO."
      ],
      "exemplos": [
        {
          "entrada": "byte",
          "saida": "LIBERADO"
        },
        {
          "entrada": "abc",
          "saida": "NEGADO"
        }
      ],
      "trechos": [
        {
          "id": "b1",
          "codigo": "s = input()",
          "tipo": "entrada"
        },
        {
          "id": "b2",
          "codigo": "if s == \"byte\":",
          "tipo": "decisao"
        },
        {
          "id": "b3",
          "codigo": "print(\"LIBERADO\")",
          "tipo": "saida"
        },
        {
          "id": "b4",
          "codigo": "else:",
          "tipo": "decisao"
        },
        {
          "id": "b5",
          "codigo": "print(\"NEGADO\")",
          "tipo": "saida"
        }
      ],
      "solucao": [
        {
          "id": "b1",
          "indent": 0
        },
        {
          "id": "b2",
          "indent": 0
        },
        {
          "id": "b3",
          "indent": 1
        },
        {
          "id": "b4",
          "indent": 0
        },
        {
          "id": "b5",
          "indent": 1
        }
      ],
      "testes": [
        {
          "entrada": "byte",
          "esperado": "LIBERADO"
        },
        {
          "entrada": "abc",
          "esperado": "NEGADO"
        }
      ],
      "dica": "Para comparar use == (dois iguais). Um = só serve para guardar um valor numa variável.",
      "disparos": 1,
      "simulacao": {
        "codigo": "if s == \"byte\":",
        "variavel": "s",
        "passos": ["\"byte\""],
        "linha": "print(\"LIBERADO\")",
        "fim": "s == \"byte\" é verdadeiro: LIBERADO"
      },
      "aprendizado": "o if conferiu a senha"
    },
