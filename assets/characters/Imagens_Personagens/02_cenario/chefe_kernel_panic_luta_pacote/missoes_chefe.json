        {
          "id": "a3",
          "indent": 1
        },
        {
          "id": "a4",
          "indent": 0
        }
      ],
      "testes": [
        {
          "entrada": "",
          "esperado": "DESLIGOU"
        }
      ],
      "dica": "O while repete enquanto a condição for verdadeira. Diminua o escudo dentro do laço (recuado) e mostre a mensagem depois, fora dele."
    },
    {
