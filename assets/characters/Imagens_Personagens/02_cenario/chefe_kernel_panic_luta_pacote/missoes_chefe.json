          "entrada": "-",
          "saida": "DESLIGOU"
        }
      ],
      "trechos": [
        {
          "id": "a1",
          "codigo": "e = 100",
          "tipo": "entrada"
        },
        {
          "id": "a2",
          "codigo": "while e > 0:",
          "tipo": "decisao"
        },
        {
          "id": "a3",
          "codigo": "e = e - 25",
          "tipo": "outro"
        },
        {
          "id": "a4",
          "codigo": "print(\"DESLIGOU\")",
          "tipo": "saida"
        },
        {
          "id": "a5",
          "codigo": "e = e + 25",
          "tipo": "outro",
          "distrator": true
        }
      ],
      "solucao": [
        {
          "id": "a1",
          "indent": 0
        },
        {
          "id": "a2",
          "indent": 0
